recursive-include src/esi_benchmark/_vendor *.py *.json *.yaml *.yml *.txt *.toml *.mdl *.md
recursive-include src/esi_benchmark/data *
recursive-include docs *.md
recursive-include configs *.json
recursive-include examples *.json
recursive-include provenance *.json *.txt
recursive-include tests *.py *.json
recursive-include tools *.py
recursive-include reports *.md *.json *.txt *.log *.xml
include LICENSE_STATUS.md THIRD_PARTY_NOTICES.md
global-exclude *.py[cod]
global-exclude __pycache__
