///\authors: Stanford Vision and Learning Lab, Cem Gokmen; Behavior-HL runner adapter
///\description: Runner-owned VRay material adapter retaining OmniGibson texture inputs.

mdl 1.8;

import ::anno::*;
import ::base::*;
import ::math::*;
import vray_maps::VRayBitmap;
import vray_maps::VRayBitmap_bump;
import vray_maps::vray_mono_output;
import vray_materials::VRayMtl;

base::texture_return multiply_colors(
    color color_1 = color(1.0, 1.0, 1.0),
    color color_2 = color(.5, .5, .5),
    float weight = 1.0
) [[anno::hidden()]]
{
    return base::blend_color_layers(
        layers: base::color_layer[](
            base::color_layer(
                layer_color: color_2,
                weight: weight,
                mode: base::color_layer_multiply
            )
        ),
        base: color_1
    );
}

export material BehaviorHLVRayMtl(
    uniform texture_2d diffuse_texture = texture_2d() [[
        anno::display_name("Diffuse Map"), anno::in_group("Maps")
    ]],
    uniform texture_2d normal_texture = texture_2d() [[
        anno::display_name("Normal Map"), anno::in_group("Maps")
    ]],
    uniform texture_2d glossiness_texture = texture_2d() [[
        anno::display_name("Reflection Glossiness Map"), anno::in_group("Maps")
    ]],
    uniform texture_2d metalness_texture = texture_2d() [[
        anno::display_name("Metalness Map"), anno::in_group("Maps")
    ]],
    uniform texture_2d refraction_texture = texture_2d() [[
        anno::display_name("Refraction Map"), anno::in_group("Maps"), anno::unused()
    ]],
    uniform texture_2d reflection_texture = texture_2d() [[
        anno::display_name("Reflection Map"), anno::in_group("Maps")
    ]],
    uniform texture_2d reflection_ior_texture = texture_2d() [[
        anno::display_name("Fresnel Reflection IOR Map"), anno::in_group("Maps")
    ]],
    color emission_color = color(1.f) [[
        anno::in_group("Emission"), anno::display_name("Emission Color")
    ]],
    uniform float emission_intensity = 0.f [[
        anno::in_group("Emission"), anno::display_name("Emission Intensity")
    ]],
    uniform float albedo_add = float(0.0) [[
        anno::display_name("Albedo Add"),
        anno::soft_range(float(-1.0f), float(1.0f)),
        anno::description("Adds a constant value to the diffuse color "),
        anno::in_group("Tints")
    ]],
    color diffuse_tint = color(1.0f) [[
        anno::display_name("Color Tint"),
        anno::description("When enabled, this color value is multiplied over the final albedo color"),
        anno::in_group("Tints")
    ]],
    uniform float reflection_roughness_constant = 0.5f [[
        anno::display_name("Reflection Roughness"),
        anno::hard_range(0.f, 1.f),
        anno::in_group("Reflections")
    ]],
    uniform float reflection_roughness_texture_influence = 1.f [[
        anno::display_name("Reflection Roughness Texture Influence"),
        anno::hard_range(0.f, 1.f),
        anno::in_group("Reflections")
    ]]
) [[anno::display_name("BehaviorHLVRayMtl")]]
= let
{
    float mapped_reflection_glossiness = vray_maps::VRayBitmap(
        filename: glossiness_texture
    ).mono;
    float mapped_reflection_roughness = math::pow(
        (1.f - mapped_reflection_glossiness), 2.f
    );
    float reflection_roughness = math::clamp(
        reflection_roughness_texture_influence * mapped_reflection_roughness
        + (1.f - reflection_roughness_texture_influence) * reflection_roughness_constant,
        0.f,
        1.f
    );
} in vray_materials::VRayMtl(
    Diffuse: multiply_colors(
        vray_maps::VRayBitmap(filename: diffuse_texture, rgb_offset: albedo_add).tint,
        diffuse_tint,
        1.0
    ).tint,
    Reflection: vray_maps::VRayBitmap(filename: reflection_texture).tint,
    reflection_glossiness: reflection_roughness_texture_influence == 1.f
        ? mapped_reflection_glossiness : 1.f - math::sqrt(reflection_roughness),
    reflection_ior: vray_maps::VRayBitmap(filename: reflection_ior_texture).mono,
    reflection_metalness: vray_maps::VRayBitmap(filename: metalness_texture).mono,
    texmap_bump: vray_maps::VRayBitmap_bump(filename: normal_texture),
    self_illumination: emission_color,
    self_illumination_multiplier: emission_intensity
);
